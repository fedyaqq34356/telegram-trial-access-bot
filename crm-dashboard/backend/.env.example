# ── Database ──
# SQLite (dev, no setup):
DATABASE_URL=sqlite:///./crm.db
# PostgreSQL (prod):
# DATABASE_URL=postgresql+psycopg2://crm:crm_password@localhost:5432/crm

# ── Auth ──
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please-use-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ── First superadmin (created on first startup) ──
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=admin123
SUPERADMIN_NAME=Главный администратор

# ── CORS (comma separated). Use your domain in prod ──
CORS_ORIGINS=http://localhost:3000

# ── Sync ──
SYNC_INTERVAL_MINUTES=15
